# Copy to .env for local testing (npm run dev). Never commit .env.
# Razorpay > Account & Settings > API keys. Use rzp_test_ keys locally; on the live site, save the
# rzp_live_ keys in /admin > Settings > Razorpay (or as Vercel environment variables).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# ADMIN_PASSWORD=at-least-8-characters   (to open /admin locally)
# OTP by SMS (optional, see docs/TURN-ON-OTP.md). Locally, OTP_PROVIDER=test prints the code in the terminal.
# OTP_PROVIDER=test
