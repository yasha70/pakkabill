{
  "manifest_version": 3,
  "name": "PakkaBill Lens – Meesho insights, auto listing and shipping check",
  "version": "2.3.0",
  "description": "Fills Meesho's catalogue form from your PakkaBill templates in one click, checks which photo gets the lowest shipping, and shows a Meesho product's seller price and sales speed.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.meesho.com/*",
    "https://supplier.meesho.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.meesho.com/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://supplier.meesho.com/*"
      ],
      "js": [
        "ship.js",
        "listcore.js",
        "list.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://pakkabill1.vercel.app/*"
      ],
      "js": [
        "core.js",
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "PakkaBill Lens",
    "default_popup": "popup.html"
  }
}
